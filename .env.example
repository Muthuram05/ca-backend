# Public HTTPS URL of the app (Instagram requires HTTPS).
# Local dev: run `ngrok http 5173` and paste the https URL here.
BASE_URL=https://your-subdomain.ngrok-free.app

# Meta App Dashboard > App settings > Basic
IG_APP_ID=
IG_APP_SECRET=

# Optional. Meta App Dashboard > Use cases > Instagram > API setup with Unified
# login > 1. Configure your app > Configuration ID. Replaces the old scope list;
# defaults to this app's configuration, so only set it to point at another app.
# IG_CONFIG_ID=
# The business portfolio that owns the Instagram account. The unified login cannot
# request business_management, so me/businesses is refused and this is how the account
# is found. Meta Business Suite > Settings; it is in the page URL as business_id.
# IG_BUSINESS_ID=
# Last resort: the Instagram user id itself, if no probe can reach it.
# IG_USER_ID=

# Any random string. Enter the same value as "Verify token" when configuring webhooks.
WEBHOOK_VERIFY_TOKEN=

# Signs the login cookie:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Encrypts Instagram tokens in the database. Keep it safe: if you lose it, every user must log in again.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Local Postgres instead:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reeldm

# Optional
# PORT=8000
# RELOAD=1
# IG_GRAPH_VERSION=v23.0
# FRONTEND_DIST=../ca-frontend/dist   # serve a built ca-frontend from this app (single deploy)
